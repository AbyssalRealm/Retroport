			<Frame name="BillingWarningFrame" hidden="true">
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="BillingWarningText" inherits="GlueFontHighlight">
							<Size x="300" y="0"/>
							<Anchors>
								<Anchor point="BOTTOM" relativeTo="CharacterSelect" relativePoint="BOTTOMLEFT" x="200" y="120"/>
