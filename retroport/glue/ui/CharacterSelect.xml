					</Frame>
				</Frames>
				<Scripts>
					<OnMouseDown>
						CharacterSelectFrame_OnMouseDown(button);
					</OnMouseDown>
					<OnMouseUp>
						CharacterSelectFrame_OnMouseUp(button);
