<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!--
	Character select laid out as Battle for Azeroth's (retroport glue package): 3.3.5's own screen,
	which BfA grew from, with BfA's character rows - selection and hover glows, the class in its
	colour, the faction's emblem, a gold-ringed service icon beside a row with a paid service - and
	BfA's button places. The delete and rename dialogs, realm split and billing frames are 3.3.5's.
	Atlas pieces are named in place holders the glue build resolves (see CharacterCreate.xml).
	-->
	<Script file="CharacterSelect.lua"/>

	<!-- a character (BfA's CharSelectCharacterButtonTemplate, without the reorder arrows 3.3.5 has no call for) -->
	<Button name="CharSelectCharacterButtonTemplate" virtual="true" hidden="true">
		<Size x="256" y="66"/>
		<HitRectInsets>
			<AbsInset left="-10" right="30" top="0" bottom="15"/>
		</HitRectInsets>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentSelection" file="Interface\Glues\CharacterSelect\Glue-CharacterSelect-Highlight" alphaMode="ADD" hidden="true">
					<Size x="256" y="70"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-20" y="8"/>
					</Anchors>
				</Texture>
				<Texture name="$parentAllianceEmblem" file="@ATLAS:characterselection_alliance_icon@" hidden="true">
					<Size x="21" y="26"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-46" y="-6"/>
					</Anchors>
					<TexCoords @COORDS:characterselection_alliance_icon@/>
				</Texture>
				<Texture name="$parentHordeEmblem" file="@ATLAS:characterselection_horde_icon@" hidden="true">
					<Size x="15" y="27"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-50" y="-6"/>
					</Anchors>
					<TexCoords @COORDS:characterselection_horde_icon@/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentButtonText" setAllPoints="true">
				<Layers>
					<Layer level="BORDER">
						<FontString name="$parentName" inherits="GlueFontNormal" justifyH="LEFT">
							<Anchors>
								<Anchor point="TOPLEFT" x="0" y="-5"/>
							</Anchors>
						</FontString>
						<FontString name="$parentInfo" inherits="GlueFontHighlightSmall" justifyH="LEFT">
							<Size x="217" y="12"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT" x="0" y="-1"/>
							</Anchors>
						</FontString>
						<FontString name="$parentLocation" inherits="GlueFontDisableSmall" justifyH="LEFT">
							<Size x="217" y="16"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentInfo" relativePoint="BOTTOMLEFT" x="0" y="1"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnClick>
				CharacterSelectButton_OnClick(self);
			</OnClick>
			<OnDoubleClick>
				CharacterSelectButton_OnDoubleClick(self);
			</OnDoubleClick>
		</Scripts>
		<HighlightTexture file="Interface\Glues\CharacterSelect\Glue-CharacterSelect-Hover" alphaMode="ADD">
			<Size x="256" y="70"/>
			<Anchors>
				<Anchor point="TOPLEFT" x="-20" y="8"/>
			</Anchors>
		</HighlightTexture>
		<NormalFont style="GlueFontNormal"/>
		<HighlightFont style="GlueFontHighlight"/>
	</Button>

	<!-- a paid service on a character: customize, race or faction change (BfA's CharSelectPaidServiceTemplate) -->
	<Button name="CharSelectPaidServiceTemplate" virtual="true" hidden="true" motionScriptsWhileDisabled="true">
		<Size x="64" y="64"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon">
					<Size x="46" y="46"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentGoldBorder" file="@ATLAS:services-icon-goldborder@">
					<Size x="62" y="62"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords @COORDS:services-icon-goldborder@/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				CharacterSelect_PaidServiceOnClick(self, button, down, self.serviceType);
			</OnClick>
			<OnEnter>
				GlueTooltip_SetOwner(self);
				GlueTooltip_SetText(self.tooltip, nil, 1.0, 1.0, 1.0);
			</OnEnter>
			<OnLeave>
				GlueTooltip:Hide();
			</OnLeave>
		</Scripts>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD">
			<Size x="46" y="46"/>
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</HighlightTexture>
	</Button>

	<ModelFFX name="CharacterSelect" toplevel="true" parent="GlueParent" setAllPoints="true" enableKeyboard="true" hidden="true">
		<Frames>
			<Frame name="CharacterSelectUI" setAllPoints="true" enableMouse="true">
